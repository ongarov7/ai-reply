    "consent.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To write a reply, AI Reply sends your text to its server and to %@. We don't store this text."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жауап жазу үшін AI Reply мәтініңізді өз серверіне және %@ жүйесіне жібереді. Біз бұл мәтінді сақтамаймыз."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы написать ответ, AI Reply передаёт ваш текст на свой сервер и в %@. Мы не сохраняем этот текст."
          }
        }
      }
    },
