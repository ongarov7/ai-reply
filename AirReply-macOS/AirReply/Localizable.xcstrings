    "bar.placeholder.compose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should I write? E.g. politely tell the client we got the documents"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не жазу керек? Мысалы: клиентке құжаттарды алғанымызды сыпайы түрде жаз"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что написать? Например: вежливо ответь клиенту, что документы получили"
          }
        }
      }
    },
    "bar.placeholder.reply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How should I reply? You can leave this empty"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қалай жауап беру керек? Бос қалдыруға болады"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как ответить? Можно оставить пустым"
          }
        }
      }
    },
