<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Mock"
             x:Class="Mock.Screens.BarReply">
  <!-- 2 · Reply: input stays on top; the copied message and one-click recipients unfold below it. -->
  <StackPanel Margin="40,40,40,0" VerticalAlignment="Top">
    <Border Classes="float">
      <StackPanel>
        <Grid ColumnDefinitions="52,*,Auto" MinHeight="56">
          <m:BrandGlyph Margin="20,19,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
          <Panel Grid.Column="1" Margin="0,16,16,16">
            <TextBlock Classes="placeholder" TextWrapping="Wrap" Text="Как ответить? Можно оставить пустым"/>
            <Border Classes="caret" VerticalAlignment="Top" Margin="0,1,0,0"/>
          </Panel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,12,12" VerticalAlignment="Bottom">
            <Border Classes="iconbtn"><Path Classes="ic" Data="{StaticResource IcMic}"/></Border>
            <Border Classes="iconbtn accent"><Path Classes="ic" Data="{StaticResource IcArrowUp}"/></Border>
          </StackPanel>
        </Grid>
        <Border Classes="hair"/>
        <StackPanel Margin="12" Spacing="8">
          <Border Classes="quote" Height="40">
            <Grid ColumnDefinitions="40,*,Auto">
              <Path Classes="ic tertiary" Data="{StaticResource IcReply}" HorizontalAlignment="Left" Margin="8,0,0,0"/>
              <TextBlock Grid.Column="1" Classes="body" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="«Добрый день! Документы дошли? Когда сможете ответить по договору?»"/>
              <Border Grid.Column="2" Classes="iconbtn small" Margin="0,0,8,0">
                <Path Classes="ic tertiary" Data="{StaticResource IcClose}"/>
              </Border>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label" Text="Другу" VerticalAlignment="Center"/><m:Keys Combo="1"/></StackPanel></Border>
            <Border Classes="chip selected"><StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label" Text="Клиенту" VerticalAlignment="Center"/><m:Keys Combo="2"/></StackPanel></Border>
            <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label" Text="Коллеге" VerticalAlignment="Center"/><m:Keys Combo="3"/></StackPanel></Border>
            <Border Classes="chip"><StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label" Text="Партнёру" VerticalAlignment="Center"/><m:Keys Combo="4"/></StackPanel></Border>
          </StackPanel>
        </StackPanel>
        <Border Classes="hair"/>
        <Grid ColumnDefinitions="*,Auto" Height="36" Margin="12,0,12,0">
          <Border Classes="btn ghost small" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ic tertiary" Data="{StaticResource IcContact}"/>
              <TextBlock Classes="caption" Text="Без профиля" VerticalAlignment="Center"/>
              <Path Classes="ic tertiary" Data="{StaticResource IcChevronDown}" Width="12" Margin="-2,0,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caption" Text="Написать ответ сразу" VerticalAlignment="Center"/>
              <m:Keys Combo="Ctrl 1–4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caption" Text="Написать" VerticalAlignment="Center"/>
              <m:Keys Combo="Enter"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
