<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Mock"
             x:Class="Mock.Screens.BarRecording">
  <!-- 4 · Dictation: the field becomes a live 40-bar waveform; the brand slot becomes the listening dot (accent, not red). -->
  <StackPanel Margin="40,40,40,0" VerticalAlignment="Top">
    <Border Classes="float">
      <StackPanel>
        <Grid ColumnDefinitions="52,*,Auto,Auto" Height="56">
          <Panel Width="18" Height="18" Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Ellipse Width="18" Height="18" Fill="{DynamicResource AccentHalo}"/>
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}"/>
          </Panel>
          <m:Wave Grid.Column="1" HorizontalAlignment="Left"/>
          <TextBlock Grid.Column="2" Classes="body" VerticalAlignment="Center" Margin="0,0,16,0">
            <Run Text="0:07"/><Run Text=" / 0:40" Foreground="{DynamicResource TextTertiary}"/>
          </TextBlock>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
            <Border Classes="iconbtn subtle"><Path Classes="ic primary" Data="{StaticResource IcClose}"/></Border>
            <Border Classes="iconbtn accent"><Path Classes="ic" Data="{StaticResource IcCheck}"/></Border>
          </StackPanel>
        </Grid>
        <Border Classes="hair"/>
        <Grid ColumnDefinitions="*,Auto" Height="36" Margin="20,0,12,0">
          <TextBlock Classes="caption" Text="Идёт запись" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caption" Text="Отменить" VerticalAlignment="Center"/>
              <m:Keys Combo="Esc"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="caption" Text="Готово" VerticalAlignment="Center"/>
              <m:Keys Combo="Enter"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
