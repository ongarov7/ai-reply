<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mock.Screens.BarRecording">
  <Border Classes="bar" Margin="0,40,0,0">
    <StackPanel>
      <!-- Recording row: the field is replaced by a live waveform -->
      <Grid Height="56" ColumnDefinitions="48,*,Auto">
        <ContentControl Classes="glyph" Margin="16,0,0,0" HorizontalAlignment="Left"/>
        <StackPanel Grid.Column="1" x:Name="Wave" Orientation="Horizontal" Spacing="5" Height="28" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,10,0">
            <Panel Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentHalo}"/>
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}"/>
            </Panel>
            <TextBlock FontFeatures="+tnum">
              <Run Text="0:07"/><Run Text=" / 0:40" Foreground="{DynamicResource TextTertiary}"/>
            </TextBlock>
          </StackPanel>
          <Border Classes="ibtn"><Path Classes="ic pri" Data="{StaticResource IcDismiss}"/></Border>
          <Border Classes="send"><Path Classes="ic" Data="{StaticResource IcCheck}"/></Border>
        </StackPanel>
      </Grid>
      <Border Classes="hair"/>
      <Border Classes="foot" Height="36">
        <Grid ColumnDefinitions="*,Auto" Margin="48,0,12,0">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="Enter"/></Border>
              <TextBlock Classes="cap sec" Text="Готово"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="Esc"/></Border>
              <TextBlock Classes="cap sec" Text="Отменить"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="cap sec" Text="Идёт запись"/>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
