<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mock.Screens.BarSignin">
  <StackPanel Margin="0,40,0,0" Spacing="32">
    <!-- Step 1: e-mail -->
    <Border Classes="bar">
      <StackPanel>
        <Grid Height="56" ColumnDefinitions="48,*,Auto">
          <ContentControl Classes="glyph" Margin="16,0,0,0" HorizontalAlignment="Left"/>
          <Rectangle Grid.Column="1" Width="1" Height="20" HorizontalAlignment="Left" Margin="-1,0,0,0" Fill="{DynamicResource TextPrimary}"/>
          <TextBlock Grid.Column="1" Classes="field ph" Text="Email для входа"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,12,0" VerticalAlignment="Center">
            <Border Classes="send off"><Path Classes="ic" Data="{StaticResource IcArrowUp}"/></Border>
          </StackPanel>
        </Grid>
        <Border Classes="hair"/>
        <Border Classes="foot" Height="36">
          <Grid ColumnDefinitions="48,*" >
            <Path Classes="ic ter" Data="{StaticResource IcInfo}" HorizontalAlignment="Left" Margin="17,0,0,0"/>
            <TextBlock Grid.Column="1" Classes="cap sec" Text="Войдите той же почтой, что и в приложении на телефоне"/>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- Step 2: 6-digit code -->
    <Border Classes="bar">
      <StackPanel>
        <Grid Height="64" ColumnDefinitions="48,*,Auto">
          <ContentControl Classes="glyph" Margin="16,0,0,0" HorizontalAlignment="Left"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="otp"><TextBlock Text="4"/></Border>
            <Border Classes="otp"><TextBlock Text="8"/></Border>
            <Border Classes="otp"><TextBlock Text="2"/></Border>
            <Border Classes="otp focus" Margin="8,0,0,0">
              <Rectangle Width="1" Height="20" Fill="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Classes="otp"/>
            <Border Classes="otp"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,12,0" VerticalAlignment="Center">
            <Border Classes="send off"><Path Classes="ic" Data="{StaticResource IcArrowUp}"/></Border>
          </StackPanel>
        </Grid>
        <Border Classes="hair"/>
        <Border Classes="foot" Height="44">
          <Grid ColumnDefinitions="48,*,Auto">
            <Path Classes="ic ter" Data="{StaticResource IcInfo}" HorizontalAlignment="Left" Margin="17,0,0,0"/>
            <TextBlock Grid.Column="1" Classes="cap sec" TextTrimming="CharacterEllipsis" Text="Код из письма на aigerim.n@mail.kz"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,4,0" VerticalAlignment="Center">
              <Border Classes="btn subtle" Height="28"><TextBlock Classes="acc" Text="Отправить снова"/></Border>
              <Border Classes="btn subtle" Height="28"><TextBlock Classes="acc" Text="Другой email"/></Border>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
