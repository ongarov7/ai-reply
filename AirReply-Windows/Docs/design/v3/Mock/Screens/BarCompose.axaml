<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Mock.Screens.BarCompose">
  <Border Classes="bar" Margin="0,40,0,0">
    <StackPanel>
      <!-- Input row -->
      <Grid ColumnDefinitions="48,*,Auto">
        <ContentControl Classes="glyph" Margin="16,19,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Panel Grid.Column="1" Margin="0,16,0,16">
          <StackPanel>
            <TextBlock Classes="field ph" Text="Что написать?"/>
            <TextBlock Classes="field ph2" Text="Например: вежливо ответь клиенту, что документы получили"/>
          </StackPanel>
          <Rectangle Width="1" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,2,0,0" Fill="{DynamicResource TextPrimary}"/>
        </Panel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,12,12,0" VerticalAlignment="Top">
          <Border Classes="ibtn"><Path Classes="ic" Data="{StaticResource IcMic}"/></Border>
          <Border Classes="send off"><Path Classes="ic" Data="{StaticResource IcArrowUp}"/></Border>
        </StackPanel>
      </Grid>
      <Border Classes="hair"/>
      <!-- Quiet hint footer -->
      <Border Classes="foot" Height="36">
        <Grid ColumnDefinitions="*,Auto" Margin="48,0,12,0">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="Enter"/></Border>
              <TextBlock Classes="cap sec" Text="Написать"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="Ctrl+D"/></Border>
              <TextBlock Classes="cap sec" Text="Диктовка"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="cap sec" Text="Быстрый вызов"/>
            <Border Classes="kbd"><TextBlock Text="Alt+Space"/></Border>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
