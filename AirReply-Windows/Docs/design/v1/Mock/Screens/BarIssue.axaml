<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:Mock.Parts" x:Class="Mock.Screens.BarIssue">
  <!-- 5 · Issue: InfoBar-style caution card (amber, never red), one line + one action -->
  <StackPanel Margin="40" Width="680" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="8">
    <Border Classes="flyout" Padding="8">
      <Border Classes="input rest" Height="40">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <p:BrandGlyph Margin="11,0,10,0"/>
          <TextBlock Grid.Column="1" Classes="body" TextTrimming="CharacterEllipsis"
                     Text="Напиши партнёру, что встречу переносим на четверг"/>
          <Border Grid.Column="2" Classes="btn subtle" Width="32" Margin="8,0,4,0">
            <Path Classes="ic sec" Data="{StaticResource IcMic}"/>
          </Border>
          <Border Grid.Column="3" Classes="btn" Width="32" Margin="0,0,3,0">
            <Path Classes="ic bold" Data="{StaticResource IcArrowUp}"/>
          </Border>
        </Grid>
      </Border>
    </Border>

    <Border Classes="flyout caution" Padding="16,8,8,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Panel Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
          <Ellipse Classes="caution" Width="16" Height="16"/>
          <Path Classes="oncaution" Data="M8,4.5 V8.75 M8,11.25 L8,11.3"/>
        </Panel>
        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
          <Run FontWeight="SemiBold" Text="Лимит на сегодня исчерпан."/>
          <Run Text="Новые ответы появятся в 00:00"/>
        </TextBlock>
        <Border Grid.Column="2" Classes="btn" Margin="12,0,0,0">
          <TextBlock Text="Тарифы" Margin="12,0"/>
        </Border>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
