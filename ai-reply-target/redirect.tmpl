[[- $platform := placeholder "campaign_platform" -]]
[[- if eq $platform "web" -]]
    [[- $hint := .Req.Header.Get "Sec-CH-UA-Platform" | trimAll `"` | trim | lower -]]
    [[- if eq $hint "android" -]]
        [[- $platform = "android" -]]
    [[- else if or (eq $hint "ios") (eq $hint "ipados") -]]
        [[- $platform = "ios" -]]
    [[- end -]]
[[- end -]]

[[- $location := "https://ai-reply.kz" -]]
[[- $separator := "?" -]]
[[- if eq $platform "ios" -]]
    [[- $location = "https://apps.apple.com/kz/app/ai-reply/id6818570150" -]]
[[- else if eq $platform "android" -]]
    [[- $location = "https://play.google.com/store/apps/details?id=kz.yerek.aireply" -]]
    [[- $separator = "&" -]]
[[- end -]]

[[- $query := .Req.URL.Query -]]
[[- range $key := list "utm_source" "utm_medium" "utm_campaign" "utm_id" "utm_term" "utm_content" "utm_source_platform" "utm_creative_format" "utm_marketing_tactic" -]]
    [[- with $query.Get $key -]]
        [[- if and (le (len .) 256) (not (regexMatch `[\x00-\x1f\x7f]` .)) -]]
            [[- $location = printf "%s%s%s=%s" $location $separator $key (urlquery .) -]]
            [[- $separator = "&" -]]
        [[- end -]]
    [[- end -]]
[[- end -]]

[[- .RespHeader.Set "Location" $location -]]
