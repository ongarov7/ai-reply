{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Explicit recording consent; background voice assistant and provider disclosure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply records only after you start dictation. An active voice session can continue while you use another app. Voice instructions are sent through AI Reply to OpenAI for transcription. You can stop recording in the app or Dynamic Island."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply дауысты тек айтып жазуды бастағаннан кейін жазады. Белсенді жазу басқа қолданбада жалғасуы мүмкін. Дауыстық нұсқаулар тану үшін AI Reply арқылы OpenAI қызметіне жіберіледі. Жазуды қолданбада немесе Dynamic Island арқылы тоқтатуға болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply записывает голос только после запуска диктовки. Активная запись может продолжаться в другом приложении. Голосовые инструкции передаются через AI Reply в OpenAI для распознавания. Остановить запись можно в приложении или Dynamic Island."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply ovozni faqat aytib yozishni boshlaganingizdan keyin yozadi. Faol yozuv boshqa ilovada davom etishi mumkin. Ovozli koʻrsatmalar AI Reply orqali OpenAI xizmatiga matnga aylantirish uchun yuboriladi. Yozuvni ilovada yoki Dynamic Island orqali toʻxtatish mumkin."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Speech recognition permission: in-app dictation only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply turns your dictation into text with Apple speech recognition. When on-device recognition is unavailable for your language, Apple's speech service processes the audio, and AI Reply receives only the text."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply айтқаныңызды Apple сөйлеуді тану қызметімен мәтінге айналдырады. Тіліңіз үшін құрылғыда тану қолжетімсіз болса, дыбысты Apple қызметі өңдейді, ал AI Reply тек мәтінді алады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply превращает диктовку в текст с помощью распознавания речи Apple. Если распознавание на устройстве для вашего языка недоступно, звук обрабатывает сервис Apple, а AI Reply получает только текст."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Reply aytganlaringizni Apple nutqni aniqlash yordamida matnga aylantiradi. Tilingiz uchun qurilmada aniqlash mavjud boʻlmasa, ovozni Apple xizmati qayta ishlaydi, AI Reply esa faqat matnni oladi."
          }
        }
      }
    }
  },
  "version": "1.1"
}
