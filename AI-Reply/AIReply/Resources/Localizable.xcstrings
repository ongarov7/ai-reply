        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Міндетті емес. Бұл үлгінің стилі мен ережелері, дайын жауап емес."
          }
        },
        "ru" : {
          "stringUnit" : {
