    "legal.consent.declined.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No AI request will be sent. AI features require permission to process this data. You can return and agree later."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI сұраныстары жіберілмейді. AI мүмкіндіктеріне осы деректерді өңдеуге рұқсат қажет. Кейін оралып, келісім бере аласыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-запросы не будут отправляться. Для AI-функций нужно разрешение на обработку этих данных. Вы можете вернуться и дать согласие позже."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI soʻrovlari yuborilmaydi. AI funksiyalari bu maʼlumotlarni qayta ishlashga ruxsat talab qiladi. Keyin qaytib rozilik berishingiz mumkin."
          }
        }
      }
    },
