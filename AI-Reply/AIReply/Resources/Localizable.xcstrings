    "settings.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied message text and generated replies are sent through the AI Reply server to the AI provider only when you request a reply. They are not stored in the database or written to logs."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көшірілген хабарлама мен жасалған жауап AI Reply сервері арқылы AI провайдеріне тек сіз жауап сұрағанда жіберіледі. Олар дерекқорда сақталмайды және журналға жазылмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст скопированного сообщения и созданный ответ передаются через сервер AI Reply AI-провайдеру только когда вы просите ответ. Они не сохраняются в базе и не записываются в логи."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nusxalangan xabar va yaratilgan javob faqat javob soʻraganingizda AI Reply serveri orqali AI provayderiga yuboriladi. Ular bazada saqlanmaydi va jurnallarga yozilmaydi."
          }
        }
      }
    },
