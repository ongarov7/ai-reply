    "permissions.fullAccess.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Access lets the keyboard read the message you copied and reach the service that writes the reply. Without it, the keyboard still types as usual."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толық рұқсат пернетақтаға көшірілген хабарламаны оқып, жауап жасайтын қызметке қосылуға мүмкіндік береді. Онсыз пернетақта әдеттегідей жаза береді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный доступ нужен, чтобы клавиатура могла прочитать скопированное сообщение и подключиться к сервису, который создаёт ответ. Без него клавиатура печатает как обычная."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toʻliq ruxsat klaviaturaga nusxalangan xabarni oʻqish va javob yaratadigan xizmatga ulanish imkonini beradi. Usiz klaviatura odatdagidek yozaveradi."
          }
        }
      }
    },
