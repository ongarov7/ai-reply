    "settings.language.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes the language of this app. The keyboard's own labels follow the layout you select on the keyboard itself."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осы қолданбаның тілін өзгертеді. Пернетақтадағы жазулар пернетақтада таңдалған орналасуға сәйкес келеді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет язык этого приложения. Надписи на самой клавиатуре следуют выбранной на ней раскладке."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilova tilini oʻzgartiradi. Klaviatura tugmalari tanlangan klaviatura tartibiga mos keladi."
          }
        }
      }
    },
    "settings.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you tap Reply, the copied message and any instruction you wrote go through the AI Reply server to the AI provider; when you tap Write, only your instruction does. With Smart correction on, an instruction you type in AI Reply's own field may be sent before you tap, to suggest a correction. Neither these texts nor the replies are stored in the database or written to logs, and what you type in other apps is never sent."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Жауап беру» түймесін басқанда көшірілген хабарлама мен нұсқауыңыз (бар болса) AI Reply сервері арқылы AI провайдеріне жіберіледі, ал «Жазу» түймесін басқанда — тек нұсқау. Ақылды түзету қосулы болса, AI Reply-дың өз өрісіне жазып жатқан нұсқауыңыз түзету ұсыну үшін түймені баспай тұрып та жіберілуі мүмкін. Бұл мәтіндер де, жауаптар да дерекқорда сақталмайды және журналға жазылмайды, ал басқа қолданбаларда терген мәтініңіз ешқайда жіберілмейді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы нажимаете «Ответить», скопированное сообщение и ваша просьба, если она есть, передаются AI-провайдеру через сервер AI Reply, а когда «Написать» — только просьба. При включённой умной коррекции просьба, которую вы пишете в поле самого AI Reply, может отправиться и до нажатия кнопки — чтобы предложить исправление. Ни эти тексты, ни ответы не сохраняются в базе и не записываются в логи, а то, что вы печатаете в других приложениях, никуда не отправляется."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Javob berish»ni bosganingizda nusxalangan xabar va koʻrsatmangiz (agar boʻlsa) AI Reply serveri orqali AI provayderiga yuboriladi, «Yozish»ni bosganingizda esa faqat koʻrsatma. Aqlli tuzatish yoqilgan boʻlsa, AI Replyning oʻz maydonida yozayotgan koʻrsatmangiz tuzatish taklif qilish uchun tugmani bosishingizdan oldin ham yuborilishi mumkin. Bu matnlar ham, javoblar ham bazada saqlanmaydi va jurnallarga yozilmaydi, boshqa ilovalarda yozganlaringiz esa hech qayerga yuborilmaydi."
          }
        }
      }
    },
