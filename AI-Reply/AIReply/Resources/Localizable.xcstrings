    "onboarding.welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply writes replies for you in WhatsApp, Telegram, Instagram, Messages and other apps where third-party keyboards work. Copied text is sent only when you ask for a reply."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply WhatsApp, Telegram, Instagram, «Хабарлар» және бөгде пернетақталар жұмыс істейтін басқа қолданбаларда сіздің орныңызға жауап жазады. Көшірілген мәтін тек сіз жауап сұрағанда жіберіледі."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply пишет ответы за вас в WhatsApp, Telegram, Instagram, «Сообщениях» и других приложениях, где работают сторонние клавиатуры. Скопированный текст отправляется, только когда вы просите ответ."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply siz uchun WhatsApp, Telegram, Instagram, Messages va tashqi klaviaturalar ishlaydigan boshqa ilovalarda javob yozadi. Nusxalangan matn faqat javob soʻraganingizda yuboriladi."
          }
        }
      }
    },
    "onboarding.welcome.mock %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chat with the AI Reply keyboard. Above the keys: the Write with AI button on the left, then %@."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply пернетақтасы ашық тұрған чат. Пернелердің үстінде: сол жақта «AI-мен жазу» түймесі, одан кейін %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат с клавиатурой AI Reply. Над клавишами: слева кнопка «Написать с AI», за ней %@."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply klaviaturasi ochiq chat. Tugmalar ustida: chapda «AI bilan yozish» tugmasi, keyin %@."
          }
        }
      }
    },
