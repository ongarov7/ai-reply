      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI features in the app and keyboard need your permission to send personal data to a third-party AI service."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қосымша мен пернетақтаның AI мүмкіндіктері үшін жеке деректерді сыртқы AI қызметіне жіберуге рұқсатыңыз қажет."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для AI-функций приложения и клавиатуры нужно ваше разрешение на передачу персональных данных стороннему AI-сервису."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilova va klaviaturadagi AI funksiyalari uchun shaxsiy maʼlumotlarni uchinchi tomon AI xizmatiga yuborishga ruxsatingiz kerak."
          }
        }
      }
    },
