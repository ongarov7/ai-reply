        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That took too long. Try again."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тым ұзаққа созылды. Қайталап көріңіз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком долго. Попробуйте ещё раз."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juda uzoq davom etdi. Qayta urinib koʻring."
          }
        }
      }
    },
    "home.howItWorks.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy a message in WhatsApp, Telegram, Instagram or any other app, switch to the AI Reply keyboard, tap who you are replying to, then tap Reply."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhatsApp, Telegram, Instagram немесе кез келген басқа қолданбада хабарламаны көшіріңіз, AI Reply пернетақтасына ауысып, кімге жауап беретініңізді таңдаңыз да, «Жауап беру» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте сообщение в WhatsApp, Telegram, Instagram или любом другом приложении, переключитесь на клавиатуру AI Reply, выберите, кому отвечаете, и нажмите «Ответить»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhatsApp, Telegram, Instagram yoki boshqa ilovada xabarni nusxalang, AI Reply klaviaturasiga oʻting, kimga javob berayotganingizni tanlang va «Javob berish»ni bosing."
          }
        }
      }
    },
    "home.howItWorks.fullAccess" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS requires Allow Full Access before any third-party keyboard can read copied text. The keyboard reads the clipboard only when you tap a template or the paste button — never in the background."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS-та кез келген бөгде пернетақта көшірілген мәтінді оқуы үшін «Толық рұқсат» қажет. Пернетақта алмасу буферін тек үлгіні немесе қою түймесін басқанда ғана оқиды — фонда ешқашан оқымайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS требует «Полный доступ», чтобы сторонняя клавиатура могла читать скопированный текст. Клавиатура обращается к буферу обмена только когда вы нажимаете на шаблон или кнопку вставки — и никогда в фоне."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS har qanday tashqi klaviatura nusxalangan matnni oʻqishi uchun «Toʻliq ruxsat»ni talab qiladi. Klaviatura buferni faqat shablonni yoki joylash tugmasini bosganingizda oʻqiydi — hech qachon fonda emas."
          }
        }
      }
    },
