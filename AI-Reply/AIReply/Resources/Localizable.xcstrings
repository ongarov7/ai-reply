    "templates.instructions.placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep responses formal. We work Monday to Friday. Never confirm an order until stock is checked."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ресми жауап беру. Дүйсенбіден жұмаға дейін жұмыс істейміз. Қойманы тексермей тапсырысты растамау."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечать формально. Работаем с понедельника по пятницу. Не подтверждать заказ до проверки наличия."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasmiy yozing. Dushanbadan jumagacha ishlaymiz. Ombor tekshirilmaguncha buyurtmani tasdiqlamang."
