    "onboarding.sample.tutorial.incoming" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! How much does your service cost?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қайырлы күн! Қызметіңіз қанша тұрады?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добрый день! Хотел узнать, сколько стоит ваша услуга?"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assalomu alaykum! Xizmatingiz qancha turadi?"
          }
        }
      }
    },
    "onboarding.sample.tutorial.instruction.female" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Politely say I'm busy today but can call tomorrow."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бүгін бос емес екенімді, бірақ ертең қоңырауласа алатынымды сыпайы айт."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вежливо скажи, что сегодня я занята, но могу созвониться завтра."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugun band ekanimni, lekin ertaga qoʻngʻiroq qila olishimni muloyim ayt."
          }
        }
      }
    },
