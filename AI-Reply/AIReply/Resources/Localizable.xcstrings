    },
    "tutorial.paste.distinction" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste permission and keyboard Full Access are separate settings. Only you can grant them in iOS. This video works offline and does not change permissions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставка и «Полный доступ» клавиатуры — разные настройки. Только вы можете разрешить их в iOS. Видео работает без интернета и не меняет разрешения."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қою рұқсаты мен пернетақтаның толық рұқсаты — бөлек баптаулар. Оларды iOS жүйесінде тек өзіңіз бересіз. Бейне интернетсіз жұмыс істейді және рұқсаттарды өзгертпейді."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joylash ruxsati va klaviaturaning Full Access sozlamasi alohida. Ularni faqat siz iOS orqali yoqasiz. Video internetsiz ishlaydi va ruxsatlarni oʻzgartirmaydi."
          }
        }
      }
    },
    "tutorial.paste.try" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try manual paste"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте ручную вставку"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қолмен қойып көріңіз"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qoʻlda joylashni sinang"
          }
        }
      }
    },
    "tutorial.paste.try.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy a short test message, then tap Paste here. This manual action does not verify or grant automatic paste permission for the keyboard. Nothing is sent or generated."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте короткий тестовый текст и нажмите «Вставить» здесь. Ручная вставка не проверяет и не выдаёт разрешение автоматической вставки для клавиатуры. Текст никуда не отправляется, генерация не запускается."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қысқа сынақ мәтінін көшіріп, мұнда «Қою» басыңыз. Қолмен қою пернетақтаның автоматты қою рұқсатын тексермейді және бермейді. Мәтін жіберілмейді, жауап жасалмайды."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qisqa sinov matnini nusxalang va shu yerda Paste ni bosing. Qoʻlda joylash klaviaturaning avtomatik joylash ruxsatini tekshirmaydi yoki bermaydi. Hech narsa yuborilmaydi yoki yaratilmaydi."
          }
        }
      }
    },
