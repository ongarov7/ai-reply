    "onboarding.keyboard.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you can add a keyboard on iPhone. It takes a few taps in Settings, and we'll show you where."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-ға пернетақтаны тек өзіңіз қоса аласыз — ол үшін параметрлерде бірнеше рет басу жеткілікті. Қай жерде екенін көрсетеміз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить клавиатуру на iPhone можете только вы — это несколько нажатий в настройках. Покажем, где именно."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’ga klaviaturani faqat oʻzingiz qoʻsha olasiz — sozlamalarda bir necha marta bosish kifoya. Qayerdaligini koʻrsatamiz."
          }
        }
      }
    },
    "onboarding.keyboard.statusFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't tell apps whether their keyboard is on. This turns green once you open the AI Reply keyboard — for example in the field at the bottom of this screen."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS қолданбаға оның пернетақтасы қосулы ма, жоқ па, хабарламайды. AI Reply пернетақтасын бір рет ашқаныңызда күй жасылға ауысады — мысалы, осы экранның төменгі жағындағы өрісте."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не сообщает приложениям, включена ли их клавиатура. Статус станет зелёным, как только вы откроете клавиатуру AI Reply — например, в поле внизу этого экрана."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ilovaga uning klaviaturasi yoqilganini bildirmaydi. AI Reply klaviaturasini bir marta ochganingizda holat yashil boʻladi — masalan, shu ekranning pastidagi maydonda."
          }
        }
      }
    },
