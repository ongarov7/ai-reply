    "settings.account.delete" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete account"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіркелгіні жою"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить аккаунт"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisobni oʻchirish"
          }
        }
      }
    },
    "settings.account.delete.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, profile, consents, usage history and devices are deleted from our server right away. This cannot be undone. The keyboard keeps working for typing."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіркелгі, профиль, келісімдер, қолданыс тарихы мен құрылғылар біздің серверден бірден жойылады. Мұны қайтару мүмкін емес. Пернетақта мәтін теру үшін жұмыс істей береді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт, профиль, согласия, история использования и устройства сразу удаляются с нашего сервера. Это нельзя отменить. Клавиатура продолжит работать для набора текста."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisob, profil, roziliklar, foydalanish tarixi va qurilmalar serverimizdan darhol oʻchiriladi. Buni bekor qilib boʻlmaydi. Klaviatura matn yozish uchun ishlashda davom etadi."
          }
        }
      }
    },
    "settings.account.delete.confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete your account?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіркелгіні жоясыз ба?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить аккаунт?"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hisob oʻchirilsinmi?"
          }
        }
      }
    },
    "settings.account.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard uses the same account. Signing out stops replies until you sign in again."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пернетақта да осы тіркелгіні пайдаланады. Шыққаннан кейін қайта кіргенше жауаптар жасалмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиатура использует тот же аккаунт. После выхода ответы не будут генерироваться до повторного входа."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaviatura ham shu hisobdan foydalanadi. Chiqsangiz, qayta kirguningizcha javoblar ishlamaydi."
          }
        }
      }
    },
