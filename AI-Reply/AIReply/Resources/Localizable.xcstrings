    "onboarding.practice.hint.copy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A friend wrote to you. Copy the message: tap Copy."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досыңыздан хабарлама келді. Оны көшіріңіз — «Көшіру» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вам написал друг. Скопируйте сообщение — нажмите «Копировать»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doʻstingiz yozdi. Xabarni nusxalang — «Nusxalash»ni bosing."
          }
        }
      }
    },
    "onboarding.practice.hint.insert" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read it through and tap Insert."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жауапты оқып шығып, «Кірістіру» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
