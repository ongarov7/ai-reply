    "onboarding.practice.done.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reply is in the message field: you check it and send it yourself. It works the same in any chat."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жауап хабарлама өрісінде тұр — оны тексеріп, өзіңіз жібересіз. Кез келген чатта дәл осылай."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответ уже в поле ввода — проверьте его и отправьте сами. В любом мессенджере всё работает так же."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javob xabar maydonida — uni tekshirib, oʻzingiz yuborasiz. Har qanday chatda xuddi shunday."
          }
        }
      }
    },
    "onboarding.practice.done.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
