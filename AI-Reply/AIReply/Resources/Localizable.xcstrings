    "settings.keyboard.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The language key switches between the layouts that are on. At least one stays on. Vibration works when Full Access is on."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тіл пернесі қосулы тілдер арасында ауыстырады. Кемінде біреуі қосулы қалады. Діріл толық рұқсат қосулы болғанда жұмыс істейді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиша языка переключает включённые раскладки. Хотя бы одна остаётся включённой. Вибрация работает при включённом полном доступе."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til tugmasi yoqilgan tartiblar orasida almashtiradi. Kamida bittasi yoqilgan qoladi. Tebranish toʻliq ruxsat yoqilganda ishlaydi."
          }
        }
      }
    },
