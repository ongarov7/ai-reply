    "setup.fullAccess.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Access lets the keyboard read the message you copied and reach the internet to write a reply. Without it the keyboard still types normally."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толық рұқсат пернетақтаға сіз көшірген хабарламаны оқып, жауап алу үшін интернетке шығуға мүмкіндік береді. Онсыз да пернетақта әдеттегідей жаза береді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный доступ нужен, чтобы клавиатура могла прочитать скопированное сообщение и обратиться в интернет за ответом. Без него клавиатура печатает как обычная."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toʻliq ruxsat klaviaturaga siz nusxalagan xabarni oʻqish va javob yaratish uchun internetga ulanish imkonini beradi. Usiz ham klaviatura odatdagidek yozadi."
          }
        }
      }
    },
    "setup.paste.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you pick who you're replying to or tap Paste message, AI Reply reads the message you copied. If iOS asks whether AI Reply may paste from WhatsApp, tap Allow Paste."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кімге жауап беретініңізді таңдағанда не «Хабарламаны қою» түймесін басқанда, AI Reply көшірілген хабарламаны оқиды. iOS AI Reply-ға WhatsApp-тан қоюға рұқсат бересіз бе деп сұраса, «Қоюға рұқсат ету» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы выбираете, кому отвечаете, или нажимаете «Вставить сообщение», AI Reply читает скопированное сообщение. Если iOS спросит, разрешить ли AI Reply вставку из WhatsApp, нажмите «Разрешить вставку»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimga javob berayotganingizni tanlaganingizda yoki «Xabarni joylash»ni bosganingizda AI Reply nusxalangan xabarni oʻqiydi. iOS AI Replyga WhatsAppdan joylashga ruxsat berasizmi deb soʻrasa, «Joylashga ruxsat berish»ni bosing."
          }
        }
      }
    },
    "setup.paste.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS asks this itself, and only after you tap. On iOS versions that have it, you can change your answer later in Settings ▸ AI Reply ▸ Paste from Other Apps."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл сұрақты iOS өзі қояды, тек сіз басқаннан кейін. Мұндай баптауы бар iOS нұсқаларында жауабыңызды кейін өзгертуге болады: «Реттеулер» ▸ AI Reply ▸ «Басқа қолданбалардан көшіріп қою»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот вопрос iOS задаёт сама и только после вашего нажатия. В версиях iOS, где есть такая настройка, ответ можно изменить позже: «Настройки» ▸ AI Reply ▸ «Вставка из других приложений»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu savolni iOS oʻzi beradi, faqat siz bosganingizdan keyin. Bunday sozlamasi bor iOS versiyalarida javobingizni keyinroq oʻzgartirish mumkin: Settings ▸ AI Reply ▸ Paste from Other Apps."
          }
        }
      }
    },
