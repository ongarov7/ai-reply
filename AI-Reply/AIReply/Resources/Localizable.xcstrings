    "profile.gender.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used only for Russian grammar: «рад» or «рада», «сделал» or «сделала». We never guess it from your name or account."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тек орыс грамматикасы үшін керек: «рад» не «рада», «сделал» не «сделала». Біз оны атыңызға не аккаунтыңызға қарап ешқашан анықтамаймыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужен только для русской грамматики: «рад» или «рада», «сделал» или «сделала». Мы никогда не определяем его по имени или аккаунту."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faqat rus tili grammatikasi uchun kerak: «рад» yoki «рада», «сделал» yoki «сделала». Biz uni ismingiz yoki akkauntingizdan hech qachon aniqlamaymiz."
          }
        }
      }
    },
