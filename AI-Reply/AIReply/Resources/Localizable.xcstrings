    "permissions.fullAccess.onlyYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you can turn it on, in iOS Settings. No app can do it for you."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оны тек өзің iOS реттеулерінде қоса аласың. Ешбір қолданба мұны сенің орныңа жасай алмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить его можешь только ты, в настройках iOS. Ни одно приложение не сделает это за тебя."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uni faqat oʻzing iOS sozlamalarida yoqa olasan. Hech bir ilova buni sen uchun qila olmaydi."
          }
        }
      }
    },
