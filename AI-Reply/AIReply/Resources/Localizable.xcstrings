    "settings.smartCorrection.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typos are fixed and words suggested on your phone — nothing you type in other apps is sent anywhere. While you write an instruction in AI Reply's own field, that text may be sent to suggest a correction. Word lists: Leipzig Corpora Collection (CC BY)."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қате сөздерді түзету мен сөз ұсыну телефонның өзінде жүреді — басқа қолданбаларда терген мәтініңіз ешқайда жіберілмейді. AI Reply-дың өз өрісіне нұсқау жазғанда, түзетілген нұсқасын ұсыну үшін бұл мәтін жіберілуі мүмкін. Сөздіктер: Leipzig Corpora Collection (CC BY)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опечатки исправляются, а слова подсказываются прямо на телефоне — то, что вы печатаете в других приложениях, никуда не отправляется. Когда вы пишете просьбу в поле самого AI Reply, её текст может отправляться, чтобы предложить исправление. Словари: Leipzig Corpora Collection (CC BY)."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xatolarni tuzatish va soʻz takliflari telefonning oʻzida ishlaydi — boshqa ilovalarda yozganlaringiz hech qayerga yuborilmaydi. AI Replyning oʻz maydonida koʻrsatma yozayotganingizda, tuzatish taklif qilish uchun bu matn yuborilishi mumkin. Lugʻatlar: Leipzig Corpora Collection (CC BY)."
          }
        }
      }
    },
    "settings.storage.unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shared container is unavailable, so the keyboard cannot see your profile. Rebuild the app with the App Group capability enabled."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ортақ контейнер қолжетімсіз, пернетақта профиліңізді көрмейді. Қолданбаны App Group мүмкіндігімен қайта жинаңыз."
          }
