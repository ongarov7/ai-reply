    "settings.smartCorrection.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typos are fixed and words suggested on your phone — nothing you type in other apps is sent anywhere. While you write an instruction in AI Reply's own field, that text may be sent to suggest a correction. Without Full Access, iOS may not pass this switch to the keyboard, and correction then stays on. Word lists: Leipzig Corpora Collection (CC BY)."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қате сөздерді түзету мен сөз ұсыну телефонның өзінде жүреді — басқа қолданбаларда терген мәтініңіз ешқайда жіберілмейді. AI Reply-дың өз өрісіне нұсқау жазғанда, түзетілген нұсқасын ұсыну үшін бұл мәтін жіберілуі мүмкін. Толық рұқсат болмаса, iOS бұл ауыстырғышты пернетақтаға жеткізбеуі мүмкін — онда түзету қосулы қалады. Сөздіктер: Leipzig Corpora Collection (CC BY)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опечатки исправляются, а слова подсказываются прямо на телефоне — то, что вы печатаете в других приложениях, никуда не отправляется. Когда вы пишете просьбу в поле самого AI Reply, её текст может отправляться, чтобы предложить исправление. Без полного доступа iOS может не передать этот переключатель клавиатуре — тогда коррекция останется включённой. Словари: Leipzig Corpora Collection (CC BY)."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xatolarni tuzatish va soʻz takliflari telefonning oʻzida ishlaydi — boshqa ilovalarda yozganlaringiz hech qayerga yuborilmaydi. AI Replyning oʻz maydonida koʻrsatma yozayotganingizda, tuzatish taklif qilish uchun bu matn yuborilishi mumkin. Toʻliq ruxsat boʻlmasa, iOS bu kalitni klaviaturaga yetkazmasligi mumkin — unda tuzatish yoqilgan holda qoladi. Lugʻatlar: Leipzig Corpora Collection (CC BY)."
          }
        }
      }
    },
