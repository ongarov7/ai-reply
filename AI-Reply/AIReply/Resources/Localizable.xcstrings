    "setup.privacy.explicit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied text is read only when you tap a template, the paste button or Reply to copied in Write with AI, and a reply is generated only when you tap Reply."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көшірілген мәтін тек үлгіні, қою түймесін не «AI-мен жазу» ішіндегі «Көшірілгенге жауап беру» түймесін басқанда оқылады, ал жауап тек «Жауап беру» түймесін басқанда жасалады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопированный текст читается только после нажатия на шаблон, кнопку вставки или «Ответить на скопированное» в «Написать с AI», а ответ создаётся только по кнопке «Ответить»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nusxalangan matn faqat shablonni, joylash tugmasini yoki «AI bilan yozish» ichidagi «Nusxalanganga javob berish»ni bosganingizda oʻqiladi, javob esa faqat «Javob berish»ni bosganingizda yaratiladi."
          }
        }
      }
    },
