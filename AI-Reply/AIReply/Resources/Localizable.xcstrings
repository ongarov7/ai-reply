    "pasteHelp.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you pick who you're replying to or tap Paste message, the AI Reply keyboard reads the message you copied, and iOS may ask every time whether it may paste. Allow it once in Settings and iOS stops asking."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кімге жауап беретініңізді таңдағанда не «Хабарламаны қою» түймесін басқанда, AI Reply пернетақтасы көшірілген хабарламаны оқиды, ал iOS әр жолы қоюға рұқсат сұрауы мүмкін. Реттеулерде бір рет рұқсат беріңіз — iOS бұдан былай сұрамайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда ты выбираешь, кому отвечаешь, или нажимаешь «Вставить сообщение», клавиатура AI Reply читает скопированное сообщение — и iOS может каждый раз спрашивать, разрешить ли вставку. Разреши её один раз в настройках, и iOS перестанет спрашивать."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimga javob berayotganingizni tanlaganingizda yoki «Xabarni joylash»ni bosganingizda AI Reply klaviaturasi nusxalangan xabarni oʻqiydi va iOS har safar joylashga ruxsat soʻrashi mumkin. Sozlamalarda bir marta ruxsat bering — iOS boshqa soʻramaydi."
          }
        }
      }
    },
    "pasteHelp.manual" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can always type the message yourself instead: in the AI Reply keyboard or here in the app."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хабарламаны әрқашан қолмен теруге болады — AI Reply пернетақтасында немесе осы қолданбада."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение всегда можно набрать вручную — в клавиатуре AI Reply или здесь, в приложении."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xabarni har doim qoʻlda yozish mumkin — AI Reply klaviaturasida yoki shu ilovada."
          }
        }
      }
    },
    "pasteHelp.nav" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қою"
          }
        },
        "ru" : {
