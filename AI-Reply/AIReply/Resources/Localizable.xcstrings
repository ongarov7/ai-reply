    "home.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text is sent only when you tap Reply or Write and, with Smart correction on, while you type an instruction in AI Reply's own field. It goes through the AI Reply server to OpenAI and is not stored in the database or written to logs; only a generated text you send with a report is kept."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мәтін тек «Жауап беру» не «Жазу» түймесін басқанда, ал ақылды түзету қосулы болса, AI Reply-дың өз өрісіне нұсқау жазып жатқанда да жіберіледі. Ол AI Reply сервері арқылы OpenAI-ға жетеді, дерекқорда сақталмайды және журналға жазылмайды; тек шағыммен бірге жіберген дайын мәтініңіз сақталады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст отправляется, только когда вы нажимаете «Ответить» или «Написать», а при включённой умной коррекции — ещё и пока вы пишете просьбу в поле самого AI Reply. Он передаётся в OpenAI через сервер AI Reply, не сохраняется в базе и не записывается в логи; сохраняется только готовый текст, который вы отправили вместе с жалобой."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matn faqat «Javob berish» yoki «Yozish»ni bosganingizda, Aqlli tuzatish yoqilgan boʻlsa esa AI Replyning oʻz maydonida koʻrsatma yozayotganingizda ham yuboriladi. U AI Reply serveri orqali OpenAI’ga boradi, bazada saqlanmaydi va jurnallarga yozilmaydi; faqat shikoyat bilan birga yuborgan tayyor matningiz saqlanadi."
          }
        }
      }
    },
