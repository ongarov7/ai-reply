    "home.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text is processed only when you request a reply. It is sent through AI Reply to the AI provider, but is not stored in the database or written to logs."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мәтін тек жауап сұраған кезде өңделеді. Ол AI Reply арқылы AI провайдеріне жіберіледі, бірақ дерекқорда сақталмайды және журналға жазылмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст обрабатывается только когда вы просите ответ. Он передаётся через AI Reply AI-провайдеру, но не сохраняется в базе и не записывается в логи."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text is processed only when you request a reply. It is sent through AI Reply to the AI provider, but is not stored in the database or written to logs."
          }
        }
      }
    },
