          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joylashga ruxsat"
          }
        }
      }
    },
    "setup.privacy.clipboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clipboard is never monitored in the background."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алмасу буфері фонда ешқашан бақыланбайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буфер обмена никогда не отслеживается в фоне."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bufer fonda hech qachon kuzatilmaydi."
          }
        }
      }
    },
    "setup.privacy.explicit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied text is read only when you tap a template or the paste button, and a reply is generated only when you tap Reply."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көшірілген мәтін тек үлгіні немесе қою түймесін басқанда оқылады, ал жауап тек «Жауап беру» түймесін басқанда жасалады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопированный текст читается только после нажатия на шаблон или кнопку вставки, а ответ создаётся только по кнопке «Ответить»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nusxalangan matn faqat shablonni yoki joylash tugmasini bosganingizda oʻqiladi, javob esa faqat «Javob berish»ni bosganingizda yaratiladi."
          }
        }
      }
    },
    "setup.privacy.noKeyInKeyboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in tokens are kept in protected app storage and are not shown in the keyboard."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кіру токендері қолданбаның қорғалған қоймасында сақталады және пернетақтада көрсетілмейді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токены входа хранятся в защищённом хранилище приложения и не показываются в клавиатуре."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirish tokenlari ilovaning himoyalangan xotirasida saqlanadi va klaviaturada koʻrsatilmaydi."
          }
        }
      }
    },
    "setup.privacy.secureFields" : {
      "extractionState" : "manual",
