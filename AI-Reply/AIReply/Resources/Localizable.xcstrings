    "tutorial.paste.limitation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings → Apps → AI Reply → Paste from Other Apps and choose Allow."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Настройки → Приложения → AI Reply → Вставка из других приложений и выберите «Разрешить»."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реттеулер → Қолданбалар → AI Reply → Басқа қолданбалардан қою бөлімін ашып, рұқсат беріңіз."
          }
        },
        "uz" : {
          "stringUnit" : {
