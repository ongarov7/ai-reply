    "permissions.section.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't tell apps whether their keyboard is on. This is what the AI Reply keyboard last reported itself, and when."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS қолданбаларға пернетақтасы қосулы ма, жоқ па, айтпайды. Мұнда AI Reply пернетақтасының өзі соңғы рет не хабарлағаны және қашан екені көрсетілген."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не сообщает приложениям, включена ли их клавиатура. Здесь — то, что клавиатура AI Reply сама сообщила в последний раз, и когда."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ilovalarga ularning klaviaturasi yoqilganmi-yoʻqmi aytmaydi. Bu yerda AI Reply klaviaturasi oxirgi marta oʻzi nima xabar bergani va qachonligi koʻrsatilgan."
          }
        }
      }
    },
