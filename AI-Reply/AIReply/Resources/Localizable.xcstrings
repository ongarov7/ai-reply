    "onboarding.tutorial.reply.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick different people and watch the reply change. It's an example: nothing is sent and no replies are used."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Әр түрлі әңгімелесушіні таңдап көріңіз — жауап өзгереді. Бұл мысал: ештеңе жіберілмейді, жауап лимиті жұмсалмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирай разных собеседников — ответ меняется. Это пример: ничего не отправляется, лимит ответов не тратится."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turli suhbatdoshlarni tanlab koʻring — javob oʻzgaradi. Bu misol: hech narsa yuborilmaydi, javoblar limiti sarflanmaydi."
          }
        }
      }
    },
