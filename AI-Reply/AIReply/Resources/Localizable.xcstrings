    "onboarding.practice.done.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The reply is in the message field: you check it and send it yourself. It works the same in any chat."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жауап хабарлама өрісінде тұр — оны тексеріп, өзіңіз жібересіз. Кез келген чатта дәл осылай."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответ уже в поле ввода — проверьте его и отправьте сами. В любом мессенджере всё работает так же."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javob xabar maydonida — uni tekshirib, oʻzingiz yuborasiz. Har qanday chatda xuddi shunday."
          }
        }
      }
    },
    "onboarding.practice.done.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're ready to use AI Reply"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бәрі дайын — AI Reply-ды пайдалана беріңіз"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё готово — пользуйтесь AI Reply"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hammasi tayyor — AI Replydan foydalanishingiz mumkin"
          }
        }
      }
    },
    "onboarding.practice.hint.copy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A friend wrote to you. Copy the message: tap Copy."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досыңыздан хабарлама келді. Оны көшіріңіз — «Көшіру» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вам написал друг. Скопируйте сообщение — нажмите «Копировать»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doʻstingiz yozdi. Xabarni nusxalang — «Nusxalash»ni bosing."
          }
        }
      }
    },
    "onboarding.practice.hint.insert" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read it through and tap Insert."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жауапты оқып шығып, «Кірістіру» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
