    "onboarding.fullAccess.onlyOnTap" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied text is read only when you pick who you're replying to, tap Paste message, or tap Reply to copied in Write with AI — never in the background."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көшірілген мәтін тек кімге жауап беретініңізді таңдағанда, «Хабарламаны қою» түймесін не «AI-мен жазу» ішіндегі «Көшірілгенге жауап беру» түймесін басқанда оқылады — фонда ешқашан оқылмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопированный текст читается, только когда вы выбираете, кому отвечаете, нажимаете «Вставить сообщение» или «Ответить на скопированное» в «Написать с AI», — и никогда в фоне."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nusxalangan matn faqat kimga javob berayotganingizni tanlaganingizda, «Xabarni joylash»ni yoki «AI bilan yozish» ichidagi «Nusxalanganga javob berish»ni bosganingizda oʻqiladi — hech qachon fonda emas."
          }
        }
      }
    },
    "onboarding.fullAccess.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply needs Full Access to send your request to the AI service and bring the reply back, and to read the message you copied when you pick who you're replying to or tap Paste message. iOS gives the clipboard and the internet only to keyboards with Full Access."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толық рұқсат AI Reply-ға сұранысыңызды AI қызметіне жіберіп, жауап алу үшін керек. Сондай-ақ ол кімге жауап беретініңізді таңдағанда не «Хабарламаны қою» түймесін басқанда көшірілген хабарламаны оқи алады. iOS алмасу буфері мен интернетті тек толық рұқсаты бар пернетақталарға ашады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный доступ нужен AI Reply, чтобы отправлять ваш запрос AI-сервису и получать ответ, а также читать скопированное сообщение, когда вы выбираете, кому отвечаете, или нажимаете «Вставить сообщение». Буфер обмена и интернет iOS открывает только клавиатурам с полным доступом."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply soʻrovingizni AI xizmatiga yuborib, javobni qaytarishi hamda kimga javob berayotganingizni tanlaganingizda yoki «Xabarni joylash»ni bosganingizda nusxalangan xabarni oʻqishi uchun toʻliq ruxsat kerak. iOS bufer va internetni faqat toʻliq ruxsatli klaviaturalarga beradi."
          }
        }
      }
    },
    "onboarding.fullAccess.statusFooter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't tell apps about Full Access. This turns green once you open the AI Reply keyboard after turning it on — for example in the field at the bottom of this screen."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS қолданбаларға толық рұқсат туралы хабарламайды. Оны қосқаннан кейін AI Reply пернетақтасын ашқанда күй жасылға ауысады — мысалы, осы экранның төменгі жағындағы өрісте."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не сообщает приложениям о полном доступе. Статус станет зелёным, когда вы откроете клавиатуру AI Reply после его включения — например, в поле внизу этого экрана."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ilovalarga toʻliq ruxsat haqida xabar bermaydi. Uni yoqqaningizdan keyin AI Reply klaviaturasini ochganingizda holat yashil boʻladi — masalan, shu ekranning pastidagi maydonda."
          }
        }
      }
    },
    "onboarding.fullAccess.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Full Access"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толық рұқсат беріңіз"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите полный доступ"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toʻliq ruxsat bering"
          }
        }
      }
    },
    "onboarding.fullAccess.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS will warn that the keyboard can send anything you type. That's the standard text for every keyboard. AI Reply sends text through its server to OpenAI only when you tap Reply or Write and, with Smart correction on, the instruction you type in its own field. Nothing you type in other apps is sent unless you select it yourself and tap Reply. Choose Allow."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS пернетақта терген мәтініңіздің бәрін жібере алады деп ескертеді. Бұл — кез келген пернетақтаға шығатын стандартты мәтін. AI Reply мәтінді өз сервері арқылы OpenAI-ға тек «Жауап беру» не «Жазу» түймесін басқанда жібереді, ал ақылды түзету қосулы болса, AI Reply өрісіне жазған нұсқауыңызды да жібереді. Басқа қолданбаларда терген мәтініңізді өзіңіз белгілеп, «Жауап беру» түймесін баспасаңыз, ол жіберілмейді. «Рұқсат ету» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS предупредит, что клавиатура может передавать всё, что вы печатаете. Это стандартный текст для любой клавиатуры. AI Reply отправляет текст через свой сервер в OpenAI, только когда вы нажимаете «Ответить» или «Написать», а при включённой умной коррекции — ещё и просьбу, которую вы пишете в поле AI Reply. То, что вы печатаете в других приложениях, не отправляется, если вы сами не выделили это и не нажали «Ответить». Нажмите «Разрешить»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS klaviatura siz yozgan hamma narsani yuborishi mumkinligi haqida ogohlantiradi. Bu har qanday klaviatura uchun standart matn. AI Reply matnni oʻz serveri orqali OpenAI’ga faqat «Javob berish» yoki «Yozish»ni bosganingizda yuboradi, Aqlli tuzatish yoqilgan boʻlsa esa AI Reply maydonida yozgan koʻrsatmangizni ham. Boshqa ilovalarda yozganlaringizni oʻzingiz belgilab, «Javob berish»ni bosmaguningizcha ular yuborilmaydi. «Ruxsat berish»ni tanlang."
          }
        }
      }
    },
    "onboarding.fullAccess.without" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without it the keyboard still types normally, and typo fixes still work on your phone."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Онсыз да пернетақта әдеттегідей жаза береді, ал қателер телефонның өзінде түзетіледі."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без него клавиатура всё равно печатает как обычно, а опечатки исправляются прямо на телефоне."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiz ham klaviatura odatdagidek yozadi, xatolar esa telefonning oʻzida tuzatiladi."
          }
        }
      }
    },
    "onboarding.gender.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply writes in your name. In Russian, some words change with the speaker's gender: «рад» or «рада», «сделал» or «сделала». This only affects replies in Russian."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply сіздің атыңыздан жазады. Орыс тілінде кейбір сөздер сөйлеушінің жынысына қарай өзгереді: «рад» не «рада», «сделал» не «сделала». Бұл тек орысша жауаптарға әсер етеді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply пишет ответы от вашего лица, а в русском языке некоторые слова меняются в зависимости от пола: «рад» или «рада», «сделал» или «сделала»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply siz nomingizdan yozadi. Rus tilida baʼzi soʻzlar soʻzlovchining jinsiga qarab oʻzgaradi: «рад» yoki «рада», «сделал» yoki «сделала». Bu faqat ruscha javoblarga taʼsir qiladi."
          }
        }
      }
    },
