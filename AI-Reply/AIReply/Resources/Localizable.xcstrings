        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пернетақта да осы тіркелгіні пайдаланады. Шыққаннан кейін қайта кіргенше жауаптар жасалмайды."
          }
        },
        "ru" : {
