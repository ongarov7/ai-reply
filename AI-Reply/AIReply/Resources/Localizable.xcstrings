            "value" : "Try it yourself"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Өзіңіз байқап көріңіз"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте сами"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oʻzingiz sinab koʻring"
          }
        }
      }
    },
    "onboarding.sample.practice.incoming" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! It's been ages. How are you?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сәлем! Көптен бері хабарласпадық. Қалайсың?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет! Давно не общались. Как ты?"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salom! Ancha vaqtdan beri gaplashmadik. Qalaysan?"
          }
        }
      }
    },
    "onboarding.sample.practice.reply.female" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hey! It really has been a while. So good to hear from you! How are you doing?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сәлем! Иә, расында көп уақыт өтті. Хабарласқаныңа қуаныштымын! Өзің қалайсың?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет! Да, действительно давно. Рада тебя слышать! Как у тебя дела?"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salom! Ha, rostdan ham ancha boʻldi. Sendan xabar kelganidan xursandman! Oʻzing qalaysan?"
          }
        }
      }
    },
