    "pasteHelp.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To reply, the AI Reply keyboard reads the message you copied, and iOS may ask every time whether it may paste. Allow it once in Settings and iOS stops asking."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жауап беру үшін AI Reply пернетақтасы көшірілген хабарламаны оқиды, ал iOS әр жолы қоюға рұқсат сұрауы мүмкін. Реттеулерде бір рет рұқсат бер — iOS бұдан былай сұрамайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы ответить, клавиатура AI Reply читает скопированное сообщение, и iOS может каждый раз спрашивать, разрешить ли вставку. Разреши её один раз в настройках — и iOS перестанет спрашивать."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javob berish uchun AI Reply klaviaturasi nusxalangan xabarni oʻqiydi va iOS har safar joylashga ruxsat soʻrashi mumkin. Sozlamalarda bir marta ruxsat ber — iOS boshqa soʻramaydi."
          }
        }
      }
    },
    "pasteHelp.manual" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can always type the message yourself instead: in the AI Reply keyboard or here in the app."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хабарламаны әрқашан қолмен теруге болады — AI Reply пернетақтасында немесе осы қолданбада."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение всегда можно набрать вручную — в клавиатуре AI Reply или здесь, в приложении."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xabarni har doim qoʻlda yozish mumkin — AI Reply klaviaturasida yoki shu ilovada."
          }
        }
      }
    },
    "pasteHelp.nav" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қою"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставка"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joylash"
          }
        }
      }
    },
    "pasteHelp.noRow" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't see that row? It appears after AI Reply has asked to paste once. Until then iOS asks itself: tap Allow Paste."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мұндай жол жоқ па? Ол AI Reply қоюды алғаш сұрағаннан кейін пайда болады. Оған дейін iOS өзі сұрайды — «Қоюға рұқсат ету» түймесін бас."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет такой строки? Она появляется после первой просьбы AI Reply о вставке. До этого iOS спрашивает сама — нажми «Разрешить вставку»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunday qator yoʻqmi? U AI Reply birinchi marta joylashni soʻragandan keyin paydo boʻladi. Ungacha iOS oʻzi soʻraydi — Allow Paste ni bos."
          }
        }
      }
    },
    "pasteHelp.onlyYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you can change this setting. No app, AI Reply included, can allow it for you."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл баптауды тек өзің өзгерте аласың. Ешбір қолданба, оның ішінде AI Reply да, сенің орныңа рұқсат бере алмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменить эту настройку можешь только ты. Ни одно приложение, и AI Reply тоже, не может разрешить вставку за тебя."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sozlamani faqat oʻzing oʻzgartira olasan. Hech bir ilova, jumladan AI Reply ham, sen uchun ruxsat bera olmaydi."
          }
        }
      }
    },
    "pasteHelp.path" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In full: Settings ▸ AI Reply ▸ Paste from Other Apps ▸ Allow."
          }
        },
        "kk" : {
          "stringUnit" : {
