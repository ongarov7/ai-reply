    "permissions.fullAccess.onlyYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you can turn it on, in iOS Settings. No app can do it for you."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оны тек өзіңіз iOS реттеулерінде қоса аласыз. Ешбір қолданба мұны сіздің орныңызға жасай алмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить его можешь только ты, в настройках iOS. Ни одно приложение не сделает это за тебя."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uni faqat oʻzingiz iOS sozlamalarida yoqa olasiz. Hech bir ilova buni siz uchun qila olmaydi."
          }
        }
      }
    },
    "permissions.fullAccess.outdated %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last confirmed %@"
          }
        },
        "kk" : {
          "stringUnit" : {
