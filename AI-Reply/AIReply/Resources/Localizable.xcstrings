    "purchase.pass.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pass's replies can be used for the stated time from the purchase. A pass bought while another runs starts when it ends."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рұқсаттама жауаптарын сатып алған сәттен бастап көрсетілген уақыт ішінде пайдалануға болады. Қолданыстағы рұқсаттама кезінде сатып алынғаны ол біткен соң басталады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответами пропуска можно пользоваться указанное время с момента покупки. Пропуск, купленный во время действующего, начнётся после его окончания."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruxsatnoma javoblaridan xarid paytidan boshlab koʻrsatilgan vaqt davomida foydalanish mumkin. Amaldagisi paytida sotib olingani u tugagach boshlanadi."
          }
        }
      }
    },
