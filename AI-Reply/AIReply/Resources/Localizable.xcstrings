          }
        }
      }
    },
    "pasteHelp.noRow" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't see that row? It appears after AI Reply has asked to paste once. Until then iOS asks itself: tap Allow Paste."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мұндай жол жоқ па? Ол AI Reply қоюды алғаш сұрағаннан кейін пайда болады. Оған дейін iOS өзі сұрайды — «Қоюға рұқсат ету» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет такой строки? Она появляется после первой просьбы AI Reply о вставке. До этого iOS спрашивает сама — нажми «Разрешить вставку»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunday qator yoʻqmi? U AI Reply birinchi marta joylashni soʻragandan keyin paydo boʻladi. Ungacha iOS oʻzi soʻraydi — Allow Paste ni bosing."
          }
        }
      }
    },
    "pasteHelp.onlyYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you can change this setting. No app, AI Reply included, can allow it for you."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл баптауды тек өзіңіз өзгерте аласыз. Ешбір қолданба, оның ішінде AI Reply да, сіздің орныңызға рұқсат бере алмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменить эту настройку можешь только ты. Ни одно приложение, и AI Reply тоже, не может разрешить вставку за тебя."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sozlamani faqat oʻzingiz oʻzgartira olasiz. Hech bir ilova, jumladan AI Reply ham, siz uchun ruxsat bera olmaydi."
          }
        }
      }
    },
