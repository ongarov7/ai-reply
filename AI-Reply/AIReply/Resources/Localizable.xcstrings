    "purchase.packs.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A one-time purchase. Replies never expire and stay with your account. They are used after your included allowance."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бір реттік сатып алу. Жауаптардың мерзімі бітпейді, олар тіркелгіде сақталады. Алдымен тарифке кіретін жауаптар жұмсалады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разовая покупка. Ответы не сгорают и сохраняются в аккаунте. Расходуются после включённых ответов."
