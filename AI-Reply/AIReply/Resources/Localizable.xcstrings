      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pack replies never expire and are used last: after the day's replies, the pass and the free ones."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пакеттегі жауаптардың мерзімі бітпейді, олар ең соңында жұмсалады: бүгінгі, рұқсаттама және тегін жауаптардан кейін."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы из пакета не сгорают и расходуются последними: после ответов на сегодня, пропуска и бесплатных."
          }
        },
        "uz" : {
