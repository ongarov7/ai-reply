      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The payment went through, but the confirmation has not reached our server yet. We will send it again by ourselves, and the replies will appear."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Төлем өтті, бірақ растау серверге әлі жетпеді. Біз оны өзіміз қайта жібереміз, жауаптар қосылады."
          }
