    "settings.account.addEmail.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in by phone number is no longer available. Add an e-mail address to keep access to this account, its plan and history."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон нөмірімен кіру енді қолжетімсіз. Осы тіркелгіге, оның тарифі мен тарихына кіруді сақтау үшін пошта мекенжайын қосыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход по номеру телефона больше недоступен. Добавьте почту, чтобы сохранить доступ к аккаунту, тарифу и истории."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon raqami orqali kirish endi mavjud emas. Hisob, tarif va tarixga kirishni saqlab qolish uchun e-pochta qoʻshing."
          }
        }
      }
    },
    "settings.account.addEmail.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an e-mail so you can sign in to this account again after signing out."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шыққаннан кейін осы тіркелгіге қайта кіру үшін пошта қосыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте почту, чтобы снова войти в этот аккаунт после выхода."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiqqaningizdan keyin bu hisobga qayta kirish uchun e-pochta qoʻshing."
          }
        }
      }
    },
