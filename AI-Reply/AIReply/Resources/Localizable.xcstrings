    "onboarding.usage.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard replies to the message you copied yourself. It cannot read your chats."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пернетақта өзіңіз көшірген хабарламаға жауап береді. Ол чаттарыңызды оқи алмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиатура отвечает на сообщение, которое вы скопировали сами. Читать переписку она не может."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaviatura faqat siz nusxalagan xabarga javob beradi. U chatlaringizni oʻqiy olmaydi."
          }
        }
      }
    },
