    "onboarding.practice.hint.persona" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap who you're replying to — say, Friend."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кімге жауап беретініңізді таңдаңыз — мысалы, «Дос»."
