            "state" : "translated",
            "value" : "Klaviaturani sozlash"
          }
        }
      }
    },
    "onboarding.welcome.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reply to clients with confidence and chat easily with the people close to you. Right from the keyboard."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиенттерге сенімді жауап беріңіз, жақындарыңызбен оңай сөйлесіңіз. Тікелей пернетақтадан."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отвечай уверенно клиентам и легко общайся с близкими. Прямо с клавиатуры."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijozlarga ishonch bilan javob bering, yaqinlaringiz bilan oson muloqot qiling. Toʻgʻridan-toʻgʻri klaviaturadan."
          }
        }
      }
    },
    "onboarding.welcome.title" : {
      "extractionState" : "manual",
