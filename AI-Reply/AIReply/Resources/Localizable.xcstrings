    "home.privacy.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text is sent only when you tap Reply or Write and, with Smart correction on, while you type an instruction in AI Reply's own field. It goes through the AI Reply server to the AI provider and is not stored in the database or written to logs."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мәтін тек «Жауап беру» не «Жазу» түймесін басқанда, ал ақылды түзету қосулы болса, AI Reply-дың өз өрісіне нұсқау жазып жатқанда да жіберіледі. Ол AI Reply сервері арқылы AI провайдеріне жетеді, дерекқорда сақталмайды және журналға жазылмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст отправляется, только когда вы нажимаете «Ответить» или «Написать», а при включённой умной коррекции — ещё и пока вы пишете просьбу в поле самого AI Reply. Он передаётся AI-провайдеру через сервер AI Reply, не сохраняется в базе и не записывается в логи."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matn faqat «Javob berish» yoki «Yozish»ni bosganingizda, Aqlli tuzatish yoqilgan boʻlsa esa AI Replyning oʻz maydonida koʻrsatma yozayotganingizda ham yuboriladi. U AI Reply serveri orqali AI provayderiga boradi, bazada saqlanmaydi va jurnallarga yozilmaydi."
          }
        }
      }
    },
