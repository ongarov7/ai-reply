        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll let you know when today's replies are running out or your plan is about to end. Choose what to receive in Settings."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бүгінгі жауаптар таусылып бара жатқанда немесе тариф аяқталуға жақындағанда хабарлаймыз. Нені алатыныңызды параметрлерде таңдай аласыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщим, когда ответы на сегодня заканчиваются или тариф подходит к концу. Что получать, можно выбрать в настройках."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugungi javoblar tugab borayotganda yoki tarif tugashiga oz qolganda sizga bildiramiz. Nimalarni olishni sozlamalarda tanlaysiz."
          }
        }
      }
    },
