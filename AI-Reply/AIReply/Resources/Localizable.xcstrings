    "onboarding.sample.tutorial.reply.female" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! Sorry, I can't talk today, but I'd be happy to call tomorrow and go over the details."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қайырлы күн! Өкінішке қарай, бүгін сөйлесе алмаймын. Ертең хабарласайық — бәрін толық талқылаймыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добрый день! Сегодня, к сожалению, не получится созвониться. Давайте свяжемся завтра — буду рада обсудить детали."
          }
        },
