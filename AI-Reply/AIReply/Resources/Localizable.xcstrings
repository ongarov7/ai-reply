    "setup.checklist.unknown.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS does not tell an app whether its own keyboard is enabled. This turns green the first time the keyboard runs."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS қолданбаға пернетақтасының қосылғанын хабарламайды. Белгі пернетақта алғаш іске қосылғанда пайда болады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS не сообщает приложению, включена ли его клавиатура. Отметка появится после первого запуска клавиатуры."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ilovaga oʻz klaviaturasi yoqilganini bildirmaydi. Klaviatura birinchi marta ishga tushganda bu holat yangilanadi."
          }
        }
      }
    },
    "setup.fullAccess.manual" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you can turn it on: Settings ▸ AI Reply ▸ Keyboards ▸ Allow Full Access. No app can enable it for you."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оны тек өзіңіз қоса аласыз: «Параметрлер» ▸ AI Reply ▸ «Пернетақталар» ▸ «Толық рұқсат». Мұны ешбір қолданба сіздің орныңызға жасай алмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включить его можете только вы: «Настройки» ▸ AI Reply ▸ «Клавиатуры» ▸ «Полный доступ». Ни одно приложение не сделает это за вас."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buni faqat siz yoqa olasiz: Sozlamalar ▸ AI Reply ▸ Klaviaturalar ▸ Toʻliq ruxsat."
          }
        }
      }
    },
    "setup.fullAccess.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Access"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толық рұқсат"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный доступ"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toʻliq ruxsat"
          }
        }
      }
    },
    "setup.fullAccess.why" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full Access lets the keyboard read the message you copied and reach the internet to write a reply. Without it the keyboard still types normally."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толық рұқсат пернетақтаға сіз көшірген хабарламаны оқып, жауап алу үшін интернетке шығуға мүмкіндік береді. Онсыз да пернетақта әдеттегідей жаза береді."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный доступ нужен, чтобы клавиатура могла прочитать скопированное сообщение и обратиться в интернет за ответом. Без него клавиатура печатает как обычная."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toʻliq ruxsat klaviaturaga siz nusxalagan xabarni oʻqish va javob yaratish uchun internetga ulanish imkonini beradi. Usiz ham klaviatura odatdagidek yozadi."
          }
        }
      }
    },
    "setup.paste.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you tap who you're replying to, AI Reply reads the message you copied. If iOS asks whether AI Reply may paste from WhatsApp, tap Allow Paste."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кімге жауап беретініңізді таңдағанда, AI Reply көшірілген хабарламаны оқиды. iOS AI Reply-ға WhatsApp-тан қоюға рұқсат бересіз бе деп сұраса, «Қоюға рұқсат ету» түймесін басыңыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы выбираете, кому отвечаете, AI Reply читает скопированное сообщение. Если iOS спросит, разрешить ли AI Reply вставку из WhatsApp, нажмите «Разрешить вставку»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimga javob berayotganingizni tanlaganingizda AI Reply nusxalangan xabarni oʻqiydi. iOS AI Replyga WhatsAppdan joylashga ruxsat berasizmi deb soʻrasa, «Joylashga ruxsat berish»ni bosing."
          }
        }
      }
    },
    "setup.paste.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS asks this itself, and only after you tap. On iOS versions that have it, you can change your answer later in Settings ▸ AI Reply ▸ Paste from Other Apps."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл сұрақты iOS өзі қояды, тек сіз басқаннан кейін. Мұндай баптауы бар iOS нұсқаларында жауабыңызды кейін өзгертуге болады: «Параметрлер» ▸ AI Reply ▸ «Басқа қолданбалардан қою»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот вопрос iOS задаёт сама и только после вашего нажатия. В версиях iOS, где есть такая настройка, ответ можно изменить позже: «Настройки» ▸ AI Reply ▸ «Вставка из других приложений»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu savolni iOS oʻzi beradi, faqat siz bosganingizdan keyin. Bunday sozlamasi bor iOS versiyalarida javobingizni keyinroq oʻzgartirish mumkin: Sozlamalar ▸ AI Reply ▸ Boshqa ilovalardan joylash."
          }
        }
      }
    },
    "setup.paste.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste permission"
          }
        },
        "kk" : {
          "stringUnit" : {
