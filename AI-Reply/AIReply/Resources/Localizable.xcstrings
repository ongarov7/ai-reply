    "setup.privacy.explicit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied text is read only when you tap a template or the paste button, and a reply is generated only when you tap Reply."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Көшірілген мәтін тек үлгіні немесе қою түймесін басқанда оқылады, ал жауап тек «Жауап беру» түймесін басқанда жасалады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопированный текст читается только после нажатия на шаблон или кнопку вставки, а ответ создаётся только по кнопке «Ответить»."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nusxalangan matn faqat shablonni yoki joylash tugmasini bosganingizda oʻqiladi, javob esa faqat «Javob berish»ni bosganingizda yaratiladi."
          }
        }
      }
    },
