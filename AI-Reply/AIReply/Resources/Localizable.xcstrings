    "legal.consent.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The accepted versions, time, language and platform are saved with your account. You can reopen both documents in Settings."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қабылданған нұсқалар, уақыт, тіл және платформа тіркелгіде сақталады. Екі құжатты да параметрлерден қайта ашуға болады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версии документов, время, язык и платформа сохраняются в аккаунте. Оба документа доступны в настройках."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qabul qilingan versiyalar, vaqt, til va platforma hisobingizda saqlanadi. Ikkala hujjatni Sozlamalarda qayta ochish mumkin."
          }
        }
      }
    },
    "legal.consent.processing.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply does not save these request texts. OpenAI may retain API content for abuse monitoring under its policies; API data is not used for model training by default. No AI request is sent without your agreement. You can withdraw it in Settings → Privacy."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply осы сұраныстардың мәтіндерін сақтамайды. OpenAI өз ережелері бойынша API мазмұнын теріс пайдалануды тексеру үшін уақытша сақтауы мүмкін; әдепкіде API деректері модель үйретуге қолданылмайды. Келісіміңізсіз AI сұраныстары жіберілмейді. Келісімді Параметрлер → Құпиялылық бөлімінде қайтара аласыз."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply не сохраняет тексты этих запросов. OpenAI может временно хранить содержимое API-запросов для проверки злоупотреблений по своим правилам; по умолчанию данные API не используются для обучения моделей. Без вашего согласия AI-запросы не отправляются. Отозвать согласие можно в Настройки → Конфиденциальность."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Reply bu soʻrov matnlarini saqlamaydi. OpenAI oʻz qoidalariga koʻra API mazmunini suiisteʼmolni tekshirish uchun vaqtincha saqlashi mumkin; API maʼlumotlari odatda modelni oʻqitish uchun ishlatilmaydi. Roziligingizsiz AI soʻrovlari yuborilmaydi. Rozilikni Sozlamalar → Maxfiylik boʻlimida qaytarib olishingiz mumkin."
          }
        }
      }
    },
    "legal.consent.processing.title" : {
