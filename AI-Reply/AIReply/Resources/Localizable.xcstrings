    "settings.account.addEmail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add e-mail for sign-in"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кіру үшін пошта қосу"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить почту для входа"
          }
        },
        "uz" : {
