        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата прошла, но подтверждение ещё не дошло до сервера. Мы отправим его ещё раз сами, и ответы появятся."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toʻlov oʻtdi, lekin tasdiq hali serverga yetmadi. Uni oʻzimiz qayta yuboramiz va javoblar qoʻshiladi."
          }
        }
      }
