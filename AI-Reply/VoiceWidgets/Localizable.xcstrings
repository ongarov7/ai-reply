        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон мен дауысты өңдеуге рұқсат беру үшін AI Reply қолданбасын бір рет ашыңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon va ovozni qayta ishlashga ruxsat berish uchun AI Reply’ni bir marta oching."
          }
        }
