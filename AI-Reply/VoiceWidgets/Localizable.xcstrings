    "Start a voice instruction without opening AI Reply after first-time setup." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a voice instruction without opening AI Reply after first-time setup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните голосовую инструкцию без открытия AI Reply после первой настройки."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бірінші баптаудан кейін AI Reply қолданбасын ашпай, дауыстық нұсқауды бастаңыз."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Birinchi sozlashdan keyin AI Reply’ni ochmasdan ovozli ko‘rsatmani boshlang."
          }
        }
      }
    },
    "Open AI Reply once to allow microphone access and voice processing." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
