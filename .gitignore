# macOS
.DS_Store

# Secrets stay on the machine that uses them. Only the *.env.example
# templates are committed; real keys go into the server's .env.
.env
.env.*
!.env.example
*.pem
*.p8
# Local Apple keys and their private backups; never bundled or committed.
AI-Reply/Config/Secrets/
*.p12
*.jks
*.keystore
# Firebase client configuration is shared with the project. Server keys stay private.
# Backend Firebase service account (FIREBASE_SERVICE_ACCOUNT_FILE points outside the repo)
ai-reply-back-end/secrets/
*firebase-adminsdk*.json
*service-account*.json
# Downloaded FCM sender key (the original local filename is kept).
ai-reply-back-end/ai-reply-4bf8f-31db4f3ee80d.json

# Logs and local build/test output
*.log
ios-simlog.txt
android-shot*.png

# Local build-watcher requests and markers (claude-build-watch.sh)
.build-request
.build-done
.claude-*
.run-lint
.watcher-v*

# Files the Claude desktop app saves into this folder
Claude outputs/
