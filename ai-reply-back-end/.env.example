# ---------------------------------------------------------------------------
# AI Reply backend — үлгі баптау. Көшіріңіз: cp .env.example .env
#
# .env файлы ЕШҚАШАН репозиторийге кірмейді. OpenAI кілті тек осы жерде тұрады:
# ол мобильді қосымшаға да, APK/IPA-ға да, клиентке де ешқашан жетпейді.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
APP_HOST=0.0.0.0
# Порттың жалғыз көзі: Go сервері, Docker порт картасы (127.0.0.1:APP_PORT)
# және healthcheck осы мәнді алады. Өзгерткен соң: docker compose up -d
APP_PORT=8080
PUBLIC_BASE_URL=https://ai-reply.kz
CONTACT_EMAIL=hello@aireply.kz
# күндік квота осы белдеу бойынша жаңарады
DEFAULT_TIMEZONE=Asia/Almaty
# reverse proxy артында true
TRUST_PROXY=false
CORS_ORIGINS=

# --- Дерекқор (SQLite; бір файл, бөлек сервер қажет емес)
# Docker-де docker-compose.yml бұл жолды тұрақты томға бекітеді: /app/data/aireply.db
# (WORKDIR=/app, яғни төмендегі мән контейнерде де сол файлға нұсқайды).
SQLITE_PATH=data/aireply.db
SQLITE_MAX_READ_CONNS=8
SQLITE_BUSY_TIMEOUT=5s
DB_MIGRATE_ON_START=true

# --- Токендер. Генерациялау: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_32_RANDOM_BYTES_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_BYTES_HEX
JWT_ISSUER=ai-reply
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Ескі мобильді build-тер үшін (install_id → token). Өшіру: LEGACY_API_ENABLED=false
AUTH_SIGNING_SECRET=REPLACE_WITH_32_RANDOM_BYTES_HEX
LEGACY_API_ENABLED=true

# --- Кіру коды (OTP): поштаға келеді, 4 цифр, 5 минут жарамды, бір кодқа 5 әрекет.
# APP_ENV=production болса, AUTH_DEMO_MODE=true сервердің іске қосылуын тоқтатады.
# Демо режимде Resend бапталмаса, код әрқашан AUTH_DEMO_OTP (тек жергілікті әзірлеу үшін).
AUTH_DEMO_MODE=true
AUTH_DEMO_OTP=1111
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
# Бір поштаға жаңа кодты қайта сұрау аралығы — оны сервер тексереді (қосымшадағы таймер тек көрсетеді)
OTP_RESEND_COOLDOWN=32s
# Тек бұрын шыққан build-тердегі телефон арқылы кіру үшін: stub | sms | whatsapp
OTP_CHANNEL=stub

# --- Пошта (Resend, https://resend.com). Кілт ТЕК осы жерде: кодта да, образда да,
# репозиторийде де жоқ. production-да міндетті. Жіберуші домені Resend-те расталған болуы керек.
# Кілт бос болса, хат жіберілмейді (әзірлеуде демо код жұмыс істейді).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ai-reply.kz
RESEND_FROM_NAME=AI Reply

# --- Google және Apple арқылы кіру. Бос мән — провайдер өшірулі, қосымша батырманы жасырады.
# Сервер токенді провайдердің ашық кілттерімен тексереді; aud өрісі осы мәндердің біріне
# тең болуы керек. Бұл идентификаторлар құпия емес.
# iOS OAuth client ID (Google Cloud ▸ APIs & Services ▸ Credentials ▸ iOS)
GOOGLE_CLIENT_ID_IOS=
# Web OAuth client ID: Android қосымшасы оны Credential Manager-ге serverClientId ретінде береді
GOOGLE_CLIENT_ID_WEB=
# iOS қосымшасының bundle ID — Sign in with Apple токенінің aud өрісі
APPLE_CLIENT_ID=kz.ai-reply.reply.keyboard.keyboard

# --- AI провайдері (тек сервер біледі)
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_OUTPUT_TOKENS=180
OPENAI_TIMEOUT=20s
# none — өріс мүлде жіберілмейді (reasoning модельдері temperature қабылдамайды); бос болса 0.7
OPENAI_TEMPERATURE=0.7

# --- Жауап сапасы (docs/AI_QUALITY.md)
# Тексеруден өтпеген жауапқа бір рет түзету сұранысы (квота бір рет жұмсалады)
AI_REPAIR_ENABLED=true
# POST /api/v1/ai/polish — нұсқауды түзету ұсынысы (квотасыз)
AI_POLISH_ENABLED=true

# --- Өнім оқиғалары (онбординг, баптау): POST /api/v1/analytics/events
# Тек рұқсат етілген атаулар мен мәндер сақталады; false болса — 404
PRODUCT_EVENTS_ENABLED=true

# --- Төлемдер. Нақты эквайринг қосылғанда: PAYMENT_MODE=live
PAYMENT_MODE=demo

# --- Әкімші (алғашқы кіру үшін; құпиясөз PBKDF2-мен хэштеліп сақталады)
ADMIN_EMAIL=admin@aireply.kz
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_PASSPHRASE
ADMIN_SESSION_TTL=8h
ADMIN_COOKIE_NAME=aireply_admin
# production-да true
ADMIN_SECURE_COOKIES=false

# --- Шектеулер
# Тек қосалқы мәндер: негізгі көз — әкімші панелі (Баптаулар ▸ AI шектеулері).
LIMIT_SOURCE_TEXT_CHARS=400
LIMIT_INSTRUCTION_CHARS=400
LIMIT_REQUEST_BODY_BYTES=32768
# Кодты сұрау: бір IP-ден сағатына және бір поштаға сағатына (екеуі де осы мән)
RATE_OTP_REQUEST_PER_HOUR=5
# Бір поштаға тәулігіне
RATE_OTP_REQUEST_PER_DAY=10
# Кодты тексеру: бір IP-ден сағатына
RATE_OTP_VERIFY_PER_HOUR=10
RATE_AI_PER_MINUTE=12
# Polish-тің жеке шелегі: бір қолданушыға минутына
RATE_POLISH_PER_MINUTE=20
# Өнім оқиғаларының жеке шелегі: бір қолданушыға минутына
RATE_EVENTS_PER_MINUTE=30
RATE_ADMIN_LOGIN_PER_HOUR=10
RATE_GENERIC_PER_MINUTE=60

# --- Push хабарламалар: Android те, iOS та Firebase Cloud Messaging арқылы
# (iOS-қа FCM өзі APNs-пен жеткізеді; APNs кілті Firebase Console-да жүктеледі).
# Кілттер ТЕК осы жерде: қосымшада да, образда да, репозиторийде де жоқ.
# false — ештеңе жіберілмейді; орнатулар тіркеле береді, автоматты оқиғалар
# «skipped» болып жазылады.
PUSH_NOTIFICATIONS_ENABLED=false
# Жіберу жұмысшысы осы процесте іске қосыла ма (бірнеше дана болса да қауіпсіз:
# әр жеткізу дерекқордағы lease арқылы бір рет қана алынады)
PUSH_WORKER_ENABLED=true
PUSH_MAX_ATTEMPTS=5
PUSH_BATCH_SIZE=50
PUSH_WORKER_CONCURRENCY=8
# Бір әкімші сағатына жібере алатын науқан саны
RATE_PUSH_CAMPAIGNS_PER_HOUR=10
# https сілтемелеріне рұқсат етілген хосттар (үтірмен, ішкі домендер де). Бос — PUBLIC_BASE_URL хосты.
# Қосымшалар https сілтемесін тек ai-reply.kz пен оның ішкі домендерінде ашады: одан кең жазудың мәні жоқ.
PUSH_LINK_HOSTS=
# «Жауаптар таусылуға жақын» хабарламасы: қалғаны лимиттің осы пайызына жеткенде
# (жоғары дөңгелектеледі, кемінде 1: 7 → 1, 30 → 3, 50 → 5). Күніне бір рет, айлық лимит болса — айына бір рет.
PUSH_QUOTA_LOW_PERCENT=10
# Аяқталған жеткізулер мен хабарламалар қанша күн сақталады (0 — өшірілмейді).
# Автоматты хабарлама жолы бәрібір кемінде 40 күн қалады: ол «айына бір рет» кепілі.
RETENTION_NOTIFICATIONS_DAYS=180
# Хабарлама хаттары (тариф қосылғанда). Тек Resend бапталса және пошта расталған болса жіберіледі.
NOTIFICATION_EMAILS_ENABLED=true

# Firebase Console ▸ Project settings ▸ Service accounts ▸ Generate new private key.
# Не JSON файлдың жолы (файлды репозиторийге салмаңыз; Docker-де файл контейнерге
# mount етілуі керек, сондықтан онда төмендегі үш мән қарапайымырақ):
FIREBASE_SERVICE_ACCOUNT_FILE=
# …не одан үш мән: project_id, client_email, private_key.
# FIREBASE_PRIVATE_KEY — PEM бір жолда \n арқылы (тырнақшада) не base64.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Журнал
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
