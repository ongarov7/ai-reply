<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reaching the AI service. Nothing else needs the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Dictation. Requested at runtime, the first time the user taps the
        microphone, and never on launch. The keyboard cannot ask for it itself
        (a Service has no permission UI), so VoicePermissionActivity below does
        the asking.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Key-press haptics, and only when the user has them switched on. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Push notifications (Android 13+). Never requested at launch: only from
        the Home card after sign-in, or from Settings ▸ Notifications.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android 11+ package visibility. Without this, SpeechRecognizer cannot
        see the on-device recognition service and every dictation fails with
        ERROR_CLIENT for no visible reason.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".AIReplyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.AIReply">

        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|locale|layoutDirection|screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AIReply">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Transparent, no UI of its own. It exists only because a Service
            cannot call requestPermissions(), and the keyboard needs the
            microphone. It shows the system dialog, reports the answer back and
            finishes; it is never a screen the user navigates to.
        -->
        <activity
            android:name=".voice.VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AIReply.Transparent" />

        <!--
            Firebase Cloud Messaging: a new token, and a push that arrives while
            the app is in the foreground. Not exported: only Google Play
            services' receiver starts it. In a build without
            google-services.json Firebase never starts, and neither does this.
        -->
        <service
            android:name=".push.AppMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            For a push the system shows while the app is in the background: our
            icon, and the "general" channel when a message names none (the
            server always names "general" or "important").
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />

        <!--
            The keyboard. BIND_INPUT_METHOD is what stops any app other than the
            system from binding to it.
        -->
        <service
            android:name=".keyboard.ReplyKeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
