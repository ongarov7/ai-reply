<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-transfer rules.

    The profile and templates are worth carrying to a new phone. The encrypted
    credential is not: its ciphertext is only decryptable by an Android Keystore
    key that is bound to the original device and never leaves it, so restoring
    it elsewhere would produce an undecryptable blob and a confusing "your key
    was rejected" error. Excluding it means the user re-enters the key on a new
    device, which is the same outcome iOS gets from
    kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly.

    aireply_device.xml is this phone's own state: which onboarding it finished
    and what has not reached the server yet. The keyboard is enabled per
    device, so a new phone must run the onboarding again rather than inherit
    "done" from the old one.

    aireply_autocorrect.xml holds the words the user taught the keyboard -
    words they typed - and stays on this phone: never synced, never sent.

    aireply_push.xml (the FCM token and the installation's sync marks)
    describes this device only. The installation id itself lives in
    noBackupFilesDir, which is never backed up, so a restored or reinstalled
    app registers as a new installation.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aireply_secure.xml" />
        <exclude domain="sharedpref" path="aireply_device.xml" />
        <exclude domain="sharedpref" path="aireply_autocorrect.xml" />
        <exclude domain="sharedpref" path="aireply_push.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aireply_secure.xml" />
        <exclude domain="sharedpref" path="aireply_device.xml" />
        <exclude domain="sharedpref" path="aireply_autocorrect.xml" />
        <exclude domain="sharedpref" path="aireply_push.xml" />
    </device-transfer>
</data-extraction-rules>
