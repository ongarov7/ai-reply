<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 equivalent of data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="aireply_secure.xml" />
    <exclude domain="sharedpref" path="aireply_device.xml" />
    <exclude domain="sharedpref" path="aireply_autocorrect.xml" />
    <!-- The emoji typed last: what the user typed, on this phone only. -->
    <exclude domain="sharedpref" path="aireply_emoji.xml" />
    <!-- Push token and installation sync state belong to this device only. -->
    <exclude domain="sharedpref" path="aireply_push.xml" />
    <!-- The session's non-secret values: device id, account e-mail, quota cache. -->
    <exclude domain="sharedpref" path="aireply_account.xml" />
    <!-- Sandbox sessions and test data never leave the test installation. -->
    <exclude domain="sharedpref" path="sandbox_aireply_secure.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_settings.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_account.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_device.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_legal.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_push.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_crash_report.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_autocorrect.xml" />
    <exclude domain="sharedpref" path="sandbox_aireply_emoji.xml" />
    <exclude domain="sharedpref" path="sandbox_tutorial_playback.xml" />
    <exclude domain="file" path="sandbox_reply-configuration.json" />
    <exclude domain="file" path="sandbox_reply-configuration.json.tmp" />
</full-backup-content>
